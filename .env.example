# ─── LLM ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Vector Database ─────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=soc-platform

# ─── Observability ───────────────────────────────────────
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=autonomous-soc-platform

# ─── External Security APIs ──────────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
NVD_API_KEY=your_nvd_api_key_here       # Optional, raises rate limits

# ─── Database ────────────────────────────────────────────
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=soc_password
POSTGRES_DB=soc_platform
DATABASE_URL=postgresql://soc_user:soc_password@localhost:5432/soc_platform

# ─── Redis / Task Queue ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── App ─────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
